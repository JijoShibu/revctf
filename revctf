#!/usr/bin/env bash
#
# revctf — automated reverse-engineering CTF analysis pipeline
#
# Build reference: revctfmasterplan_v6.md (consolidates v3/v4/v5 + execution masterplan).
# Milestone: M0 — foundation & scaffolding.
#
# NOTE ON `set -e`: deliberately NOT used at the top level. Masterplan v5 §4.1 specifies
# stage-level isolate-and-continue — a failing stage must be diagnosed and skipped, never
# allowed to abort the run. Error handling is done per-stage via ERR traps in lib/.
set -uo pipefail

REVCTF_VERSION="0.1.0-dev"

# --- Resolve our own location (works through a symlink on PATH, per install.sh) --------
__revctf_self="${BASH_SOURCE[0]}"
while [[ -L $__revctf_self ]]; do
    __revctf_link=$(readlink "$__revctf_self")
    if [[ $__revctf_link == /* ]]; then
        __revctf_self=$__revctf_link
    else
        __revctf_self="$(dirname "$__revctf_self")/$__revctf_link"
    fi
done
REVCTF_ROOT="$(cd -- "$(dirname -- "$__revctf_self")" && pwd)"
unset __revctf_self __revctf_link

REVCTF_LIB="$REVCTF_ROOT/lib"
REVCTF_SCRIPTS="$REVCTF_ROOT/scripts"
REVCTF_HOME="${REVCTF_HOME:-$HOME/.revctf}"
export REVCTF_VERSION REVCTF_ROOT REVCTF_LIB REVCTF_SCRIPTS REVCTF_HOME

# ======================================================================================
# Option state
# ======================================================================================
# Three-level precedence (v6 §9): built-in defaults -> ~/.revctf/config -> CLI flags.
# CLI flags are recorded in CLI_SET as they are parsed, then re-applied after the config
# file loads, so a config value can never silently override an explicit flag.

declare -A OPT=(
    [output_dir]=""                 # empty => ./revctf-reports/<basename>-<timestamp>/
    [timeout]=10                    # v3 §3 / v6 §1: ltrace timeout, seconds
    [flag_scan]=1
    [flag_format]=""
    [full_hexdump]=0
    [skip_ltrace]=0
    [skip_strace]=0
    [skip_ghidra]=0
    [no_unwrap]=0
    [unwrap_depth]=2
    [light_decompile]=0
    [force_full_decompile]=0
    [ghidra_script]=""
    [jobs_light]=""                 # empty => tier-resolved (v6 §5)
    [jobs_ghidra]=""
    [maxmem_ghidra]=""
    [sandbox]=0
    [interactive]=0
    [assume_yes]=0
    [tui]=1
    [summary_only]=0
    [dry_run]=0
    [verbose]=0
    [debug]=0
    [strict]=0                      # stop at the first failed stage (v6 §11 D8)
    [stages_disabled]=""            # comma-separated stage names (v6 §8)
)
declare -A CLI_SET=()

# The config key registry and loader live in lib/config.sh (M4). They are kept together
# because that file is the single place an untrusted external value enters OPT, and QA-1
# — a config word reaching an arithmetic test and exiting the shell from inside a stage —
# was exactly that boundary failing. One auditable file beats coercion scattered here.

CONFIG_PATH="$REVCTF_HOME/config"
SUBCOMMAND=""
TARGET=""

# ======================================================================================
# Bootstrap-phase messaging
# ======================================================================================
# lib/errorlog.sh (M9) replaces these once loaded; they exist so M0/M1 failures before
# the libraries are sourced still produce a clean message rather than a bare shell error.
_msg()  { printf '%s\n' "$*" >&2; }
die()   { printf 'revctf: error: %s\n' "$*" >&2; exit 1; }
warn()  { printf 'revctf: warning: %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
revctf — automated reverse-engineering CTF analysis pipeline

USAGE
    revctf scan <file|dir> [options]
    revctf --help | --version

  Runs a staged Kali toolchain against a challenge file (or every file in a
  directory) and writes a plain-text report with flag candidates at the top.

OUTPUT & REPORTING
    --output DIR          Report directory  [default: ./revctf-reports/<name>-<ts>/]
    --summary-only        Lead with flags + one-line-per-stage status
    --dry-run             Print resolved tier/concurrency/ceilings, run no tools

FLAG DETECTION
    --no-flag-scan        Disable flag-pattern detection entirely
    --flag-format REGEX   Add a custom High-confidence pattern
                          (e.g. --flag-format 'HTB\{.*?\}')

ANALYSIS DEPTH / STAGE CONTROL
    --full-hexdump        Dump the whole file instead of the 512-byte preview
    --skip-ltrace         Skip the ltrace stage
    --skip-strace         Skip the strace stage. Both it and ltrace execute the
                          challenge binary; --sandbox isolates them (M6).
    --skip-ghidra         Skip Ghidra; radare2 disassembly substitutes
    --no-unwrap           Disable the triage/unwrap pre-stage (packers, archives,
                          managed and Python artifacts)
    --strict              Stop at the first failed stage instead of continuing.
                          Default is to isolate a failure and carry on.
    --light-decompile     Substitute radare2 disassembly for Ghidra's decompile
    --force-full-decompile
                          Force full Ghidra decompile even on Tier C / after an OOM
    --ghidra-script PATH  Override automatic Ghidra post-script selection

RESOURCE TUNING
    --timeout SECONDS     ltrace timeout  [default: 10]
    --jobs-light N        [PARTIAL: M7] Override tier Phase-1 concurrency.
                          Resolved and reported; concurrency itself arrives
                          with batch mode, as single-file mode runs one at a time
    --jobs-ghidra N       [PARTIAL: M7] Override tier Phase-2/3 concurrency
                          (same reason as --jobs-light)
    --maxmem-ghidra M     Override the tier's Ghidra MAXMEM ceiling

SANDBOXING
    --sandbox             Run ltrace inside a network-isolated Docker container

AGENCY & INTERACTIVITY
    -i, --interactive     [NOT YET: M8] Pause before each stage: Continue /
                          Skip stage / Skip file / Abort
    -y, --yes             [NOT YET: M8] Auto-accept every prompt (CI-safe)

DISPLAY & CONFIG
    --no-tui              Disable the live stage table; use line-mode output
    --config PATH         Use an alternate config file
                          [default: ~/.revctf/config]

DIAGNOSTICS
    --verbose             Human-readable stage trace on stderr
    --debug               [NOT YET: M9] Full command trace to a debug log
    -h, --help            Show this help
        --version         Show version

NOT YET IMPLEMENTED IN THIS BUILD
    Flags above marked [NOT YET: Mn] parse and validate but have no effect; the
    milestone that implements each is named. [PARTIAL: Mn] means the value is
    resolved and shown by --dry-run but not yet enforced during a scan. This
    list is asserted by the verification harness, so it cannot drift silently.

EXIT STATUS
    0   scan completed, every stage succeeded
    2   scan completed, but one or more stages failed (see the report);
        also returned when --strict stopped the run early
    1   the scan could not run: bad arguments, missing tools, unwritable output
    130 interrupted (Ctrl+C); 143 on SIGTERM, 129 on SIGHUP

  NOTE  When revctf is backgrounded from a script (revctf scan x &), POSIX
        requires the shell to make it ignore SIGINT, so Ctrl+C-style aborts
        cannot be trapped there. Send SIGTERM instead. Interactive Ctrl+C
        works normally.

EXAMPLES
    revctf scan ./crackme
    revctf scan ./challenges/ --summary-only
    revctf scan ./bin --flag-format 'picoCTF\{.*?\}' --sandbox
    revctf scan ./packed.exe --no-unwrap --verbose
    revctf scan ./big.elf --dry-run

Persistent state lives in ~/.revctf/ (config, error.log).
EOF
}

# ======================================================================================
# Helpers
# ======================================================================================
set_opt() { OPT["$1"]="$2"; CLI_SET["$1"]=1; }

# Kept out of the argument `case` because a shellcheck directive is only valid in front
# of a complete command, never a single case branch.
# shellcheck disable=SC2034  # CLI_SET is read by config_load() in lib/config.sh
set_config_path() { CONFIG_PATH="$1"; CLI_SET[config_path]=1; }

need_value() {
    # $1 = flag name, $2 = number of remaining argv entries
    [[ $2 -ge 2 ]] || die "$1 requires a value (see 'revctf --help')"
}

is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

# ======================================================================================
# Argument parsing
# ======================================================================================
parse_args() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    # Global-only forms, valid without a subcommand.
    case "$1" in
        -h|--help)  usage; exit 0 ;;
        --version)  printf 'revctf %s\n' "$REVCTF_VERSION"; exit 0 ;;
        -*)         die "unknown option '$1' (a subcommand must come first; try 'revctf --help')" ;;
    esac

    SUBCOMMAND="$1"; shift
    case "$SUBCOMMAND" in
        scan) ;;
        *)    die "unknown subcommand '$SUBCOMMAND' (only 'scan' is supported)" ;;
    esac

    while [[ $# -gt 0 ]]; do
        case "$1" in
            # --- output & reporting ---
            --output)       need_value "$1" $#; set_opt output_dir "$2"; shift 2 ;;
            --summary-only) set_opt summary_only 1; shift ;;
            --dry-run)      set_opt dry_run 1; shift ;;

            # --- flag detection ---
            --no-flag-scan) set_opt flag_scan 0; shift ;;
            --flag-format)  need_value "$1" $#; set_opt flag_format "$2"; shift 2 ;;

            # --- analysis depth / stage control ---
            --full-hexdump)         set_opt full_hexdump 1; shift ;;
            --skip-ltrace)          set_opt skip_ltrace 1; shift ;;
            --skip-strace)          set_opt skip_strace 1; shift ;;
            --skip-ghidra)          set_opt skip_ghidra 1; shift ;;
            --no-unwrap)            set_opt no_unwrap 1; shift ;;
            --strict)               set_opt strict 1; shift ;;
            --light-decompile)      set_opt light_decompile 1; shift ;;
            --force-full-decompile) set_opt force_full_decompile 1; shift ;;
            --ghidra-script)        need_value "$1" $#; set_opt ghidra_script "$2"; shift 2 ;;

            # --- resource tuning ---
            --timeout)       need_value "$1" $#; set_opt timeout "$2"; shift 2 ;;
            --jobs-light)    need_value "$1" $#; set_opt jobs_light "$2"; shift 2 ;;
            --jobs-ghidra)   need_value "$1" $#; set_opt jobs_ghidra "$2"; shift 2 ;;
            --maxmem-ghidra) need_value "$1" $#; set_opt maxmem_ghidra "$2"; shift 2 ;;

            # --- sandboxing ---
            --sandbox) set_opt sandbox 1; shift ;;

            # --- agency & interactivity ---
            -i|--interactive) set_opt interactive 1; shift ;;
            -y|--yes)         set_opt assume_yes 1; shift ;;

            # --- display & config ---
            --no-tui) set_opt tui 0; shift ;;
            --config) need_value "$1" $#; set_config_path "$2"; shift 2 ;;

            # --- diagnostics ---
            --verbose) set_opt verbose 1; shift ;;
            --debug)   set_opt debug 1; shift ;;

            -h|--help) usage; exit 0 ;;
            --version) printf 'revctf %s\n' "$REVCTF_VERSION"; exit 0 ;;

            --) shift; break ;;
            -*) die "unknown option '$1' (try 'revctf --help')" ;;
            *)
                [[ -z $TARGET ]] || die "only one target may be given (got '$TARGET' and '$1')"
                TARGET="$1"; shift ;;
        esac
    done

    # Any remaining positional after `--`
    while [[ $# -gt 0 ]]; do
        [[ -z $TARGET ]] || die "only one target may be given (got '$TARGET' and '$1')"
        TARGET="$1"; shift
    done
}

# ======================================================================================
# Config file (v6 §9)
# ======================================================================================
# load_config — source lib/config.sh, then read ~/.revctf/config into OPT.
#
# Sourced here rather than in cmd_scan because validate_opts() needs CONFIG_BOOL_KEYS,
# and both run before any subcommand dispatch.
load_config() {
    # shellcheck source=/dev/null
    source "$REVCTF_LIB/config.sh" || die "cannot load $REVCTF_LIB/config.sh"
    config_load
}

# ======================================================================================
# Validation
# ======================================================================================
validate_opts() {
    [[ -n $TARGET ]] || die "no target given — usage: revctf scan <file|dir>"
    [[ -e $TARGET ]] || die "target not found: $TARGET"
    [[ -r $TARGET ]] || die "target not readable: $TARGET"

    # Reject anything that is not a regular file or a directory. A FIFO blocks forever on
    # the first read, and a character device like /dev/zero or /dev/urandom is an infinite
    # stream — either wedges the pipeline until an internal timeout fires, after having
    # written an unbounded capture to disk. Neither is ever a real CTF target.
    if [[ ! -f $TARGET && ! -d $TARGET ]]; then
        local kind="special file"
        [[ -p $TARGET ]] && kind="named pipe (FIFO)"
        [[ -c $TARGET ]] && kind="character device"
        [[ -b $TARGET ]] && kind="block device"
        [[ -S $TARGET ]] && kind="socket"
        die "target is a $kind, not a regular file: $TARGET"
    fi

    # A boolean that is not 0/1 would abort the shell the moment it reaches an `-eq` test,
    # which under `set -u` cannot be caught by the stage error boundary. Config values are
    # already coerced in load_config(); this is the belt-and-braces check.
    local b
    if [[ ${OPT[strict]} -eq 1 && ${OPT[interactive]} -eq 1 ]]; then
        warn "--strict and --interactive both stop the run on a problem; --strict wins on a stage failure"
    fi

    for b in $CONFIG_BOOL_KEYS interactive assume_yes summary_only dry_run verbose debug; do
        [[ ${OPT[$b]} == 0 || ${OPT[$b]} == 1 ]] \
            || die "internal: option '$b' has a non-boolean value '${OPT[$b]}'"
    done

    if ! is_uint "${OPT[timeout]}" || [[ ${OPT[timeout]} -eq 0 ]]; then
        die "--timeout must be a positive integer (got '${OPT[timeout]}')"
    fi
    if ! is_uint "${OPT[unwrap_depth]}"; then
        die "unwrap_depth must be a non-negative integer (got '${OPT[unwrap_depth]}')"
    fi

    local k
    for k in jobs_light jobs_ghidra; do
        [[ -z ${OPT[$k]} ]] && continue
        if ! is_uint "${OPT[$k]}" || [[ ${OPT[$k]} -eq 0 ]]; then
            die "--${k//_/-} must be a positive integer (got '${OPT[$k]}')"
        fi
    done

    if [[ -n ${OPT[maxmem_ghidra]} ]] && ! [[ ${OPT[maxmem_ghidra]} =~ ^[0-9]+[MmGg]?$ ]]; then
        die "--maxmem-ghidra must look like 1024M or 2G (got '${OPT[maxmem_ghidra]}')"
    fi

    if [[ -n ${OPT[ghidra_script]} && ! -r ${OPT[ghidra_script]} ]]; then
        die "--ghidra-script not readable: ${OPT[ghidra_script]}"
    fi

    if [[ -n ${OPT[flag_format]} ]]; then
        printf '' | grep -Eq -- "${OPT[flag_format]}" 2>/dev/null
        [[ $? -le 1 ]] || die "--flag-format is not a valid ERE: ${OPT[flag_format]}"
    fi

    # --- documented conflicts (v5 §3.3, §3.4) ---
    if [[ ${OPT[interactive]} -eq 1 && ${OPT[assume_yes]} -eq 1 ]]; then
        warn "--interactive and --yes are mutually exclusive; --yes wins, continuing non-interactively"
        OPT[interactive]=0
    fi
    if [[ ${OPT[sandbox]} -eq 1 && ${OPT[skip_ltrace]} -eq 1 ]]; then
        warn "--sandbox is a no-op with --skip-ltrace (the sandbox only ever wraps ltrace)"
    fi
    if [[ ${OPT[light_decompile]} -eq 1 && ${OPT[force_full_decompile]} -eq 1 ]]; then
        die "--light-decompile and --force-full-decompile are mutually exclusive"
    fi
    if [[ ${OPT[skip_ghidra]} -eq 1 && ${OPT[force_full_decompile]} -eq 1 ]]; then
        die "--skip-ghidra and --force-full-decompile are mutually exclusive"
    fi

    # A TUI needs a terminal; fall back silently rather than emitting escape codes
    # into a pipe (v6 §10).
    if [[ ${OPT[tui]} -eq 1 && ! -t 1 ]]; then
        OPT[tui]=0
    fi
}

# ======================================================================================
# Subcommand: scan
# ======================================================================================
cmd_scan() {
    if [[ ${OPT[verbose]} -eq 1 ]]; then
        _msg "revctf $REVCTF_VERSION"
        _msg "  target      : $TARGET"
        _msg "  config      : ${CONFIG_PATH}$([[ -r $CONFIG_PATH ]] || printf ' (absent)')"
        _msg "  output      : ${OPT[output_dir]:-<auto>}"
        _msg "  display     : $([[ ${OPT[tui]} -eq 1 ]] && printf tui || printf line)"
        _msg "  interactive : ${OPT[interactive]}   assume-yes: ${OPT[assume_yes]}"
    fi

    # --- Preflight ---------------------------------------------------------------
    # shellcheck source=/dev/null
    source "$REVCTF_LIB/preflight.sh" || die "cannot load $REVCTF_LIB/preflight.sh"

    local out_hint="${OPT[output_dir]:-.}"
    local pf_ok=1
    preflight_run "$out_hint" "${OPT[skip_ghidra]}" || pf_ok=0

    # A missing tool is a hard error for a real scan (v6 §11 D7) — but NOT for --dry-run.
    # Refusing to print the plan because a tool is absent defeats the flag: "would this
    # run, and how?" is exactly the question being asked, and "no, and here is what is
    # missing" is a useful answer. The plan reports the verdict instead of swallowing it.
    if [[ ${OPT[dry_run]} -eq 0 && $pf_ok -eq 0 ]]; then
        return 1
    fi

    if [[ ${OPT[verbose]} -eq 1 ]]; then
        preflight_summary >&2
    fi

    # --- Tier resolution + the --dry-run short-circuit ----------------------------
    # Resolved once per run, not per file (v6 §5), so a batch cannot drift between files.
    # shellcheck source=/dev/null
    source "$REVCTF_LIB/tier.sh" || die "cannot load $REVCTF_LIB/tier.sh"
    tier_resolve

    # --dry-run must run NOTHING. It was previously parsed and then ignored, so a flag the
    # README recommends before committing to a large batch quietly performed the full scan
    # it was meant to preview — 78 seconds on a 220MB target. It returns here: before the
    # stage modules are even sourced, before Stage 0, before any directory is created.
    if [[ ${OPT[dry_run]} -eq 1 ]]; then
        dry_run_plan "$pf_ok"
        return 0
    fi

    # --- Stage framework + every analysis stage ----------------------------------
    local m
    for m in stage stage_dynamic stage_triage stage_file stage_strings stage_binwalk \
             stage_hexdump stage_checksec stage_objdump stage_ltrace stage_radare2 \
             stage_strace stage_floss stage_managed stage_pydecomp stage_ghidra \
             watchdog flagscan tui report; do
        # shellcheck source=/dev/null
        source "$REVCTF_LIB/$m.sh" || die "cannot load $REVCTF_LIB/$m.sh"
    done

    if [[ -d $TARGET ]]; then
        printf 'revctf: batch mode is not yet implemented (M7); pass a single file for now.\n' >&2
        return 1
    fi

    scan_one_file "$TARGET"
}

# _abort_run <signal-name> — abort handler for INT, TERM and HUP.
#
# Exits 128+N for the signal received, the shell convention (130 for INT, 143 for TERM,
# 129 for HUP), so a supervisor can tell how the run was stopped.
#
# HUP is trapped because without it a dropped SSH session or a closed terminal killed the
# scan outright: no cleanup, work directory stranded, and on M3+ the traced challenge
# binary left running.
#
# KNOWN LIMIT — SIGINT cannot be caught when revctf is started as a background job from a
# NON-INTERACTIVE shell (`revctf scan x &` inside a script or CI runner). POSIX requires
# the shell to set SIGINT and SIGQUIT to ignored for such jobs, and bash will not install a
# trap for a signal that was ignored on entry; the process shows `SigIgn: …6` in
# /proc/<pid>/status. This is not fixable from inside bash. Use SIGTERM to stop a
# backgrounded revctf — it is trapped and behaves identically. Interactive Ctrl+C is
# unaffected, because the terminal delivers SIGINT to the foreground process group.
_abort_run() {
    local sig="${1:-INT}" num=2
    case "$sig" in INT) num=2 ;; TERM) num=15 ;; HUP) num=1 ;; esac
    trap - INT TERM HUP EXIT
    printf '\nrevctf: %s received — cleaning up\n' "SIG$sig" >&2
    # Before stage_kill_child, so the poller cannot mistake a deliberate teardown for a
    # breach and kill the tree a second time. Guarded: the abort path is reachable from
    # before lib/watchdog.sh is sourced.
    declare -F watchdog_stop >/dev/null 2>&1 && watchdog_stop
    # Kill the tool the current stage is waiting on, by its recorded PID. Signalling the
    # process group (`kill -- -$$`) was the obvious alternative and is wrong here: revctf
    # is only a process-group leader when a job-control shell made it one, so from a script
    # or a CI runner `-$$` names either nothing or, worse, somebody else's group.
    stage_kill_child
    stage_end_file
    exit $(( 128 + num ))
}

# resolve_output_dir <target> — ./revctf-reports/<basename>-<timestamp>/ unless --output
# was given (v6 §8).
resolve_output_dir() {
    local target="$1" base stamp
    if [[ -n ${OPT[output_dir]} ]]; then
        printf '%s' "${OPT[output_dir]}"
        return 0
    fi
    base="$(basename -- "$target")"
    stamp="$(date +%Y%m%d-%H%M%S)"
    printf './revctf-reports/%s-%s' "$base" "$stamp"
}

# dry_run_plan — print the resolved plan and run nothing.
#
# Everything here is read from already-resolved state: no tool is launched, no file is
# read beyond a stat, and no directory is created. That is the whole contract of the flag.
dry_run_plan() {
    local pf_ok="${1:-1}" size="unknown" outdir bytes
    # lib/stage.sh is deliberately NOT sourced on this path, so st_human_size is not
    # available here. `numfmt` is coreutils and always present; the raw byte count is the
    # fallback rather than a dependency.
    if [[ -f $TARGET ]]; then
        bytes="$(stat -c '%s' "$TARGET" 2>/dev/null || printf 0)"
        size="$(numfmt --to=iec --suffix=B "$bytes" 2>/dev/null || printf '%s bytes' "$bytes")"
    fi
    outdir="$(resolve_output_dir "$TARGET")"

    printf '======================================================================\n'
    printf ' revctf %s — dry run (nothing was executed)\n' "$REVCTF_VERSION"
    printf '======================================================================\n'
    printf 'Target        : %s\n' "$TARGET"
    printf 'Size          : %s\n' "$size"
    printf 'Kind          : %s\n' \
        "$([[ -d $TARGET ]] && printf 'directory (batch mode lands in M7)' || printf 'file')"
    printf 'Output would be: %s\n' "$outdir"
    printf 'Config        : %s\n' \
        "$CONFIG_PATH$([[ -r $CONFIG_PATH ]] || printf ' (absent — built-in defaults)')"
    if [[ $pf_ok -eq 1 ]]; then
        printf 'Preflight     : passed — every required tool was found\n'
    else
        printf 'Preflight     : FAILED — a real scan would refuse to start (detail above)\n'
    fi
    printf '\n'
    tier_report

    printf '\nStages that would run\n'
    # The ceiling is printed per stage, not just as the tier summary above, because this
    # listing is the ONLY place the mapping from stage to ceiling is visible — and
    # tools/run-tests.sh now derives its enforcement checks from it rather than hardcoding
    # stage names. Hardcoding "radare2 and floss" is precisely why dyn_run's bypass of
    # st_run_bounded survived M5: strace had a ceiling, said so under --verbose, and nothing
    # enforced it, because no check ever asked which stages have one.
    local st label reason ceil bound
    for st in triage:"classify and unwrap" file:"identify the file type" \
              strings:"extract printable strings" binwalk:"scan for embedded files" \
              hexdump:"capture a hex view" checksec:"read mitigations and metadata" \
              objdump:"cross-check with binutils" ltrace:"trace library calls (EXECUTES the target)" \
              radare2:"disassemble" strace:"trace syscalls (EXECUTES the target)" \
              floss:"recover obfuscated strings" managed:"decompile managed code" \
              pydecomp:"decompile Python bytecode" ghidra:"decompile with Ghidra"; do
        label="${st#*:}"; st="${st%%:*}"
        reason="$(dry_run_skip_reason "$st")"
        ceil="$(tier_ceiling_for_stage "$st")"
        is_uint "$ceil" || ceil=0
        bound=""
        [[ $ceil -gt 0 ]] && bound="  [ceiling ${ceil}MB]"
        if [[ -n $reason ]]; then
            printf '  [skip] %-9s %s — %s%s\n' "$st" "$label" "$reason" "$bound"
        else
            printf '  [run ] %-9s %s%s\n' "$st" "$label" "$bound"
        fi
    done

    printf '\nFlag detection : %s\n' \
        "$([[ ${OPT[flag_scan]} -eq 1 ]] && printf 'on, across every capture' || printf 'off (--no-flag-scan)')"
    [[ -n ${OPT[flag_format]} ]] && printf 'Custom pattern : %s\n' "${OPT[flag_format]}"
    printf 'Report style   : %s\n' \
        "$([[ ${OPT[summary_only]} -eq 1 ]] && printf 'summary only' || printf 'full detail')"
    printf 'On failure     : %s\n' \
        "$([[ ${OPT[strict]} -eq 1 ]] && printf 'stop at the first failed stage (--strict)' || printf 'isolate and continue')"
    printf 'ltrace timeout : %ss\n' "${OPT[timeout]}"

    printf '\nStage-level skip decisions that depend on the file itself — whether it is a\n'
    printf 'managed assembly, Python bytecode, packed, or a container — are made by Stage 0\n'
    printf 'at scan time and cannot be predicted here without reading the file.\n'
    printf '\nNothing was executed. Re-run without --dry-run to scan.\n'
    return 0
}

# dry_run_skip_reason <stage> — why a stage would not run, or empty if it would.
# Only reasons knowable WITHOUT touching the target; format-based skips belong to Stage 0.
dry_run_skip_reason() {
    local st="$1"
    if [[ -n ${OPT[stages_disabled]} && ",${OPT[stages_disabled]}," == *",$st,"* ]]; then
        printf 'disabled by --disable-stages'; return 0
    fi
    case "$st" in
        triage)  [[ ${OPT[no_unwrap]} -eq 1 ]] && printf 'unwrapping disabled (--no-unwrap)' ;;
        ltrace)  if [[ ${OPT[skip_ltrace]} -eq 1 ]]; then printf 'skipped by --skip-ltrace'
                 elif [[ ${OPT[sandbox]} -eq 1 ]]; then printf 'refused: --sandbox has no container until M6'; fi ;;
        strace)  if [[ ${OPT[skip_strace]} -eq 1 ]]; then printf 'skipped by --skip-strace'
                 elif [[ ${OPT[sandbox]} -eq 1 ]]; then printf 'refused: --sandbox has no container until M6'; fi ;;
        ghidra)  if [[ ${OPT[skip_ghidra]} -eq 1 ]]; then printf 'skipped by --skip-ghidra; radare2 substitutes'
                 elif [[ $TIER == C && ${OPT[force_full_decompile]} -eq 0 ]]; then
                     printf 'Tier C default: skipped for radare2-only (--force-full-decompile overrides)'; fi ;;
    esac
    return 0
}

# scan_one_file <path> — Stage 0 then the Phase-1 light stages.
# Phases 2 and 3 (heavy extras, Ghidra) land in M3; report assembly lands in M4.
scan_one_file() {
    local target="$1" outdir
    outdir="$(resolve_output_dir "$target")"

    stage_begin_file "$target" "$outdir" || {
        die "could not prepare the working or output directory for $target"; }

    # Cleanup. Full SIGINT abort semantics come in M9 (v5 §4.5); this is the minimum that
    # leaves nothing behind.
    #
    # EXIT matters as much as INT/TERM: without it, any path that ends the shell without
    # reaching stage_end_file — a `die`, or a `set -u` abort inside a stage — strands the
    # work directory. That was observed leaking a directory per crash.
    #
    # The INT handler also kills the whole process group before exiting. `stage_capture`
    # runs its tool as a child, and a bare `exit` left it running: a Ctrl+C during a
    # `strings` over a large target left orphaned processes behind. This matters more from
    # M3 on, where ltrace and strace *execute the challenge binary* — an orphan there is a
    # piece of untrusted code still running after the user thinks they stopped it.
    trap 'watchdog_stop; stage_end_file' EXIT
    trap '_abort_run INT'  INT
    trap '_abort_run TERM' TERM
    trap '_abort_run HUP'  HUP

    # M5: the global RSS backstop (v4 §3). Starts after the traps so a breach during the
    # very first stage still tears down cleanly, and stops in every exit path above.
    watchdog_start "$TIER_RAM_MB" "$TIER_WATCHDOG_PCT"

    # run_stage wraps stage_run with --strict handling. Default behaviour is unchanged:
    # v5 §4.1 isolate-and-continue. --strict (v6 §11 D8) stops at the first failure, for
    # scripted use where a partial report is worse than an early exit.
    local aborted=0
    run_stage() {
        [[ $aborted -eq 1 ]] && return 0
        # Register before running so the live table shows the stage as pending-then-running
        # rather than materialising only once it has finished.
        stage_set_status "$1" pending
        tui_stage_start "$1" "$2"
        stage_run "$1" "$2" "$3"
        tui_stage_end "$1"

        # The watchdog kills the tools, not revctf, so the stage simply looks like it
        # failed. Without this the report would blame the tool for a kill revctf ordered.
        # v6 §7.3: the watchdog is one of only two things that stop a run outright — so no
        # further stage runs, but the partial report is still written.
        if watchdog_tripped; then
            stage_set_status "$1" failed "RSS watchdog: $(watchdog_reason)"
            printf 'revctf: RSS watchdog fired — %s\n' "$(watchdog_reason)" >&2
            printf 'revctf: stopping after stage "%s"; the partial report will still be written.\n' "$1" >&2
            aborted=1
            return 0
        fi

        if [[ ${OPT[strict]} -eq 1 && ${STAGE_STATUS[$1]:-} == failed ]]; then
            printf 'revctf: --strict: stopping after stage "%s" failed (%s)\n' \
                "$1" "${STAGE_NOTE[$1]:-no detail}" >&2
            aborted=1
        fi
        return 0
    }

    # 14 = Stage 0 plus the 13 analysis stages (v6 §4). The count is what lets the display
    # say "3/14" instead of an open-ended spinner; a wrong count is cosmetic, never fatal.
    tui_init 14

    # Stage 0 first, always: every later stage must analyse the real payload rather than
    # a packer stub or a container (v6 §4.1).
    run_stage triage   "classifying and unwrapping the target" stage_triage

    # Phase 1 — light static, plus ltrace. Order within a phase is v6 §4.2.
    run_stage file     "identifying the file type"             stage_file
    run_stage strings  "extracting printable strings"          stage_strings
    run_stage binwalk  "scanning for embedded files"           stage_binwalk
    run_stage hexdump  "capturing a hex view"                  stage_hexdump
    run_stage checksec "reading mitigations and metadata"      stage_checksec
    run_stage objdump  "cross-checking with binutils"          stage_objdump
    run_stage ltrace   "tracing library calls"                 stage_ltrace
    run_stage radare2  "disassembling"                         stage_radare2

    # Phase 2 — heavy extras. Separated from Phase 3 so the two never contend for memory
    # (v6 §7.2); in single-file mode the phases are sequential anyway, and the boundary is
    # what M7's batch concurrency will schedule against.
    run_stage strace   "tracing syscalls"                      stage_strace
    run_stage floss    "recovering obfuscated strings"         stage_floss
    run_stage managed  "decompiling managed code"              stage_managed
    run_stage pydecomp "decompiling Python bytecode"           stage_pydecomp

    # Phase 3 — Ghidra, alone.
    run_stage ghidra   "decompiling with Ghidra"               stage_ghidra

    # Flag scan runs across EVERY capture, not just strings (v6 §6.3).
    if [[ ${OPT[flag_scan]} -eq 1 ]]; then
        tui_note "scanning every capture for flag candidates"
        flagscan_run
    fi

    # --- M4: assemble and emit the report -----------------------------------------
    # tui_finish first: the progress display owns the terminal until this point, and the
    # report must not be interleaved with a half-drawn table.
    tui_finish
    report_build

    # Exit status distinguishes "ran, all stages fine" from "ran, some stages failed".
    # Both are successful runs under v5 §4.1's isolate-and-continue rule, but a script or
    # CI job driving revctf had no way to tell them apart — every scan exited 0 even when
    # every stage had failed. Hard errors (bad arguments, missing tools, unwritable output)
    # keep exit 1; a completed scan with at least one failed stage now exits 2.
    local s failed=0
    for s in "${STAGE_ORDER[@]}"; do
        [[ ${STAGE_STATUS[$s]:-} == failed ]] && failed=$(( failed + 1 ))
    done

    trap - INT TERM HUP EXIT
    watchdog_stop
    stage_end_file

    if [[ $failed -gt 0 ]]; then
        printf 'revctf: completed with %d stage(s) failed\n' "$failed" >&2
        return 2
    fi
    return 0
}

# ======================================================================================
# Entry
# ======================================================================================
main() {
    parse_args "$@"
    load_config
    validate_opts

    case "$SUBCOMMAND" in
        scan) cmd_scan ;;
        *)    die "unhandled subcommand '$SUBCOMMAND'" ;;
    esac
}

main "$@"
