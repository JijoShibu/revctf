#!/usr/bin/env bash
#
# revctf — automated reverse-engineering CTF analysis pipeline
#
# Build reference: revctfmasterplan_v6.md (consolidates v3/v4/v5 + execution masterplan).
# Milestone: M0 — foundation & scaffolding.
#
# NOTE ON `set -e`: deliberately NOT used at the top level. Masterplan v5 §4.1 specifies
# stage-level isolate-and-continue — a failing stage must be diagnosed and skipped, never
# allowed to abort the run. Error handling is done per-stage via ERR traps in lib/.
set -uo pipefail

REVCTF_VERSION="0.1.0-dev"

# --- Resolve our own location (works through a symlink on PATH, per install.sh) --------
__revctf_self="${BASH_SOURCE[0]}"
while [[ -L $__revctf_self ]]; do
    __revctf_link=$(readlink "$__revctf_self")
    if [[ $__revctf_link == /* ]]; then
        __revctf_self=$__revctf_link
    else
        __revctf_self="$(dirname "$__revctf_self")/$__revctf_link"
    fi
done
REVCTF_ROOT="$(cd -- "$(dirname -- "$__revctf_self")" && pwd)"
unset __revctf_self __revctf_link

REVCTF_LIB="$REVCTF_ROOT/lib"
REVCTF_SCRIPTS="$REVCTF_ROOT/scripts"
REVCTF_HOME="${REVCTF_HOME:-$HOME/.revctf}"
export REVCTF_VERSION REVCTF_ROOT REVCTF_LIB REVCTF_SCRIPTS REVCTF_HOME

# ======================================================================================
# Option state
# ======================================================================================
# Three-level precedence (v6 §9): built-in defaults -> ~/.revctf/config -> CLI flags.
# CLI flags are recorded in CLI_SET as they are parsed, then re-applied after the config
# file loads, so a config value can never silently override an explicit flag.

declare -A OPT=(
    [output_dir]=""                 # empty => ./revctf-reports/<basename>-<timestamp>/
    [timeout]=10                    # v3 §3 / v6 §1: ltrace timeout, seconds
    [flag_scan]=1
    [flag_format]=""
    [full_hexdump]=0
    [skip_ltrace]=0
    [skip_ghidra]=0
    [no_unwrap]=0
    [unwrap_depth]=2
    [light_decompile]=0
    [force_full_decompile]=0
    [ghidra_script]=""
    [jobs_light]=""                 # empty => tier-resolved (v6 §5)
    [jobs_ghidra]=""
    [maxmem_ghidra]=""
    [auto_swap]=1
    [sandbox]=0
    [interactive]=0
    [assume_yes]=0
    [tui]=1
    [summary_only]=0
    [dry_run]=0
    [verbose]=0
    [debug]=0
    [stages_disabled]=""            # comma-separated stage names (v6 §8)
)
declare -A CLI_SET=()

# Keys a config file is permitted to set (v6 §9 — allowlist validation).
CONFIG_ALLOWED="output_dir timeout flag_scan flag_format full_hexdump skip_ltrace \
skip_ghidra no_unwrap unwrap_depth light_decompile force_full_decompile ghidra_script \
jobs_light jobs_ghidra maxmem_ghidra auto_swap sandbox tui stages_disabled"

# Of those, which are booleans and which are integers. Both groups are consumed in `-eq`
# tests, which is arithmetic context — and under `set -u` a non-numeric word there is
# evaluated as a variable name and aborts the shell outright. A config line as ordinary as
# `tui = yes` would therefore kill the run, and `full_hexdump = on` would kill it *inside a
# stage*, where `set -e`-free isolate-and-continue cannot save it. So every value from a
# config file is coerced or rejected before it can reach an arithmetic test.
CONFIG_BOOL_KEYS="flag_scan full_hexdump skip_ltrace skip_ghidra no_unwrap \
light_decompile force_full_decompile auto_swap sandbox tui"
CONFIG_INT_KEYS="timeout unwrap_depth jobs_light jobs_ghidra"

CONFIG_PATH="$REVCTF_HOME/config"
SUBCOMMAND=""
TARGET=""

# ======================================================================================
# Bootstrap-phase messaging
# ======================================================================================
# lib/errorlog.sh (M9) replaces these once loaded; they exist so M0/M1 failures before
# the libraries are sourced still produce a clean message rather than a bare shell error.
_msg()  { printf '%s\n' "$*" >&2; }
die()   { printf 'revctf: error: %s\n' "$*" >&2; exit 1; }
warn()  { printf 'revctf: warning: %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
revctf — automated reverse-engineering CTF analysis pipeline

USAGE
    revctf scan <file|dir> [options]
    revctf --help | --version

  Runs a staged Kali toolchain against a challenge file (or every file in a
  directory) and writes a plain-text report with flag candidates at the top.

OUTPUT & REPORTING
    --output DIR          Report directory  [default: ./revctf-reports/<name>-<ts>/]
    --summary-only        Lead with flags + one-line-per-stage status
    --dry-run             Print resolved tier/concurrency/ceilings, run no tools

FLAG DETECTION
    --no-flag-scan        Disable flag-pattern detection entirely
    --flag-format REGEX   Add a custom High-confidence pattern
                          (e.g. --flag-format 'HTB\{.*?\}')

ANALYSIS DEPTH / STAGE CONTROL
    --full-hexdump        Dump the whole file instead of the 512-byte preview
    --skip-ltrace         Skip the ltrace stage
    --skip-ghidra         Skip Ghidra; radare2 disassembly substitutes
    --no-unwrap           Disable the triage/unwrap pre-stage (packers, archives,
                          managed and Python artifacts)
    --light-decompile     Substitute radare2 disassembly for Ghidra's decompile
    --force-full-decompile
                          Force full Ghidra decompile even on Tier C / after an OOM
    --ghidra-script PATH  Override automatic Ghidra post-script selection

RESOURCE TUNING
    --timeout SECONDS     ltrace timeout  [default: 10]
    --jobs-light N        Override tier's Phase-1 concurrency
    --jobs-ghidra N       Override tier's Phase-2/3 concurrency
    --maxmem-ghidra M     Override tier's Ghidra MAXMEM (e.g. 1024M)
    --no-auto-swap        Never auto-create a swap file on a low-RAM host

SANDBOXING
    --sandbox             Run ltrace inside a network-isolated Docker container

AGENCY & INTERACTIVITY
    -i, --interactive     Pause before each stage: Continue / Skip stage /
                          Skip file / Abort
    -y, --yes             Auto-accept every prompt (CI-safe; overrides -i)

DISPLAY & CONFIG
    --no-tui              Disable the live stage table; use line-mode output
    --config PATH         Use an alternate config file
                          [default: ~/.revctf/config]

DIAGNOSTICS
    --verbose             Human-readable stage trace on stderr
    --debug               Full command trace to <output>/<name>.debug.log
    -h, --help            Show this help
        --version         Show version

EXIT STATUS
    0   scan completed, every stage succeeded
    2   scan completed, but one or more stages failed (see the report)
    1   the scan could not run: bad arguments, missing tools, unwritable output
    130 interrupted (Ctrl+C); 143 on SIGTERM, 129 on SIGHUP

  NOTE  When revctf is backgrounded from a script (revctf scan x &), POSIX
        requires the shell to make it ignore SIGINT, so Ctrl+C-style aborts
        cannot be trapped there. Send SIGTERM instead. Interactive Ctrl+C
        works normally.

EXAMPLES
    revctf scan ./crackme
    revctf scan ./challenges/ --summary-only
    revctf scan ./bin --flag-format 'picoCTF\{.*?\}' --sandbox
    revctf scan ./packed.exe --no-unwrap --verbose
    revctf scan ./big.elf --dry-run

Persistent state lives in ~/.revctf/ (config, error.log).
EOF
}

# ======================================================================================
# Helpers
# ======================================================================================
set_opt() { OPT["$1"]="$2"; CLI_SET["$1"]=1; }

need_value() {
    # $1 = flag name, $2 = number of remaining argv entries
    [[ $2 -ge 2 ]] || die "$1 requires a value (see 'revctf --help')"
}

is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

# ======================================================================================
# Argument parsing
# ======================================================================================
parse_args() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    # Global-only forms, valid without a subcommand.
    case "$1" in
        -h|--help)  usage; exit 0 ;;
        --version)  printf 'revctf %s\n' "$REVCTF_VERSION"; exit 0 ;;
        -*)         die "unknown option '$1' (a subcommand must come first; try 'revctf --help')" ;;
    esac

    SUBCOMMAND="$1"; shift
    case "$SUBCOMMAND" in
        scan) ;;
        *)    die "unknown subcommand '$SUBCOMMAND' (only 'scan' is supported)" ;;
    esac

    while [[ $# -gt 0 ]]; do
        case "$1" in
            # --- output & reporting ---
            --output)       need_value "$1" $#; set_opt output_dir "$2"; shift 2 ;;
            --summary-only) set_opt summary_only 1; shift ;;
            --dry-run)      set_opt dry_run 1; shift ;;

            # --- flag detection ---
            --no-flag-scan) set_opt flag_scan 0; shift ;;
            --flag-format)  need_value "$1" $#; set_opt flag_format "$2"; shift 2 ;;

            # --- analysis depth / stage control ---
            --full-hexdump)         set_opt full_hexdump 1; shift ;;
            --skip-ltrace)          set_opt skip_ltrace 1; shift ;;
            --skip-ghidra)          set_opt skip_ghidra 1; shift ;;
            --no-unwrap)            set_opt no_unwrap 1; shift ;;
            --light-decompile)      set_opt light_decompile 1; shift ;;
            --force-full-decompile) set_opt force_full_decompile 1; shift ;;
            --ghidra-script)        need_value "$1" $#; set_opt ghidra_script "$2"; shift 2 ;;

            # --- resource tuning ---
            --timeout)       need_value "$1" $#; set_opt timeout "$2"; shift 2 ;;
            --jobs-light)    need_value "$1" $#; set_opt jobs_light "$2"; shift 2 ;;
            --jobs-ghidra)   need_value "$1" $#; set_opt jobs_ghidra "$2"; shift 2 ;;
            --maxmem-ghidra) need_value "$1" $#; set_opt maxmem_ghidra "$2"; shift 2 ;;
            --no-auto-swap)  set_opt auto_swap 0; shift ;;

            # --- sandboxing ---
            --sandbox) set_opt sandbox 1; shift ;;

            # --- agency & interactivity ---
            -i|--interactive) set_opt interactive 1; shift ;;
            -y|--yes)         set_opt assume_yes 1; shift ;;

            # --- display & config ---
            --no-tui) set_opt tui 0; shift ;;
            --config) need_value "$1" $#; CONFIG_PATH="$2"; CLI_SET[config_path]=1; shift 2 ;;

            # --- diagnostics ---
            --verbose) set_opt verbose 1; shift ;;
            --debug)   set_opt debug 1; shift ;;

            -h|--help) usage; exit 0 ;;
            --version) printf 'revctf %s\n' "$REVCTF_VERSION"; exit 0 ;;

            --) shift; break ;;
            -*) die "unknown option '$1' (try 'revctf --help')" ;;
            *)
                [[ -z $TARGET ]] || die "only one target may be given (got '$TARGET' and '$1')"
                TARGET="$1"; shift ;;
        esac
    done

    # Any remaining positional after `--`
    while [[ $# -gt 0 ]]; do
        [[ -z $TARGET ]] || die "only one target may be given (got '$TARGET' and '$1')"
        TARGET="$1"; shift
    done
}

# ======================================================================================
# Config file (v6 §9)
# ======================================================================================
load_config() {
    [[ -r $CONFIG_PATH ]] || {
        # An explicitly-requested config that does not exist is an error; the default
        # one simply being absent is not.
        [[ -n ${CLI_SET[config_path]:-} ]] && die "config file not readable: $CONFIG_PATH"
        return 0
    }

    local lineno=0 line key value
    while IFS= read -r line || [[ -n $line ]]; do
        lineno=$((lineno + 1))
        line="${line%%#*}"                       # strip comments
        line="${line#"${line%%[![:space:]]*}"}"  # ltrim
        line="${line%"${line##*[![:space:]]}"}"  # rtrim
        [[ -z $line ]] && continue

        if [[ $line != *=* ]]; then
            warn "$CONFIG_PATH:$lineno: ignoring malformed line (expected key=value)"
            continue
        fi

        key="${line%%=*}"; value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"

        if [[ " $CONFIG_ALLOWED " != *" $key "* ]]; then
            warn "$CONFIG_PATH:$lineno: ignoring unknown key '$key'"
            continue
        fi

        # Config loses to an explicit CLI flag.
        [[ -n ${CLI_SET[$key]:-} ]] && continue

        # Coerce/validate before the value can reach an arithmetic test.
        if [[ " $CONFIG_BOOL_KEYS " == *" $key "* ]]; then
            case "${value,,}" in
                1|yes|true|on|enabled)   value=1 ;;
                0|no|false|off|disabled) value=0 ;;
                *)  warn "$CONFIG_PATH:$lineno: '$key' expects a yes/no value (got '$value'); using the default"
                    continue ;;
            esac
        elif [[ " $CONFIG_INT_KEYS " == *" $key "* ]]; then
            if ! is_uint "$value"; then
                warn "$CONFIG_PATH:$lineno: '$key' expects a whole number (got '$value'); using the default"
                continue
            fi
        elif [[ $key == output_dir || $key == ghidra_script ]]; then
            # README documents `output_dir = ~/ctf/reports`. A config file is read, not
            # sourced, so `~` would otherwise be taken literally and create a directory
            # actually named "~".
            # The config file is read, not sourced, so this is the only place `~` gets
            # expanded. Compared character-wise to keep a literal tilde out of a path
            # context. README documents `output_dir = ~/ctf/reports`, which would
            # otherwise create a directory actually named "~".
            if [[ ${value:0:1} == '~' ]]; then
                if [[ ${#value} -eq 1 || ${value:1:1} == '/' ]]; then
                    value="$HOME${value:1}"
                fi
            fi
        fi

        OPT["$key"]="$value"
    done < "$CONFIG_PATH"
}

# ======================================================================================
# Validation
# ======================================================================================
validate_opts() {
    [[ -n $TARGET ]] || die "no target given — usage: revctf scan <file|dir>"
    [[ -e $TARGET ]] || die "target not found: $TARGET"
    [[ -r $TARGET ]] || die "target not readable: $TARGET"

    # Reject anything that is not a regular file or a directory. A FIFO blocks forever on
    # the first read, and a character device like /dev/zero or /dev/urandom is an infinite
    # stream — either wedges the pipeline until an internal timeout fires, after having
    # written an unbounded capture to disk. Neither is ever a real CTF target.
    if [[ ! -f $TARGET && ! -d $TARGET ]]; then
        local kind="special file"
        [[ -p $TARGET ]] && kind="named pipe (FIFO)"
        [[ -c $TARGET ]] && kind="character device"
        [[ -b $TARGET ]] && kind="block device"
        [[ -S $TARGET ]] && kind="socket"
        die "target is a $kind, not a regular file: $TARGET"
    fi

    # A boolean that is not 0/1 would abort the shell the moment it reaches an `-eq` test,
    # which under `set -u` cannot be caught by the stage error boundary. Config values are
    # already coerced in load_config(); this is the belt-and-braces check.
    local b
    for b in $CONFIG_BOOL_KEYS interactive assume_yes summary_only dry_run verbose debug; do
        [[ ${OPT[$b]} == 0 || ${OPT[$b]} == 1 ]] \
            || die "internal: option '$b' has a non-boolean value '${OPT[$b]}'"
    done

    if ! is_uint "${OPT[timeout]}" || [[ ${OPT[timeout]} -eq 0 ]]; then
        die "--timeout must be a positive integer (got '${OPT[timeout]}')"
    fi
    if ! is_uint "${OPT[unwrap_depth]}"; then
        die "unwrap_depth must be a non-negative integer (got '${OPT[unwrap_depth]}')"
    fi

    local k
    for k in jobs_light jobs_ghidra; do
        [[ -z ${OPT[$k]} ]] && continue
        if ! is_uint "${OPT[$k]}" || [[ ${OPT[$k]} -eq 0 ]]; then
            die "--${k//_/-} must be a positive integer (got '${OPT[$k]}')"
        fi
    done

    if [[ -n ${OPT[maxmem_ghidra]} ]] && ! [[ ${OPT[maxmem_ghidra]} =~ ^[0-9]+[MmGg]?$ ]]; then
        die "--maxmem-ghidra must look like 1024M or 2G (got '${OPT[maxmem_ghidra]}')"
    fi

    if [[ -n ${OPT[ghidra_script]} && ! -r ${OPT[ghidra_script]} ]]; then
        die "--ghidra-script not readable: ${OPT[ghidra_script]}"
    fi

    if [[ -n ${OPT[flag_format]} ]]; then
        printf '' | grep -Eq -- "${OPT[flag_format]}" 2>/dev/null
        [[ $? -le 1 ]] || die "--flag-format is not a valid ERE: ${OPT[flag_format]}"
    fi

    # --- documented conflicts (v5 §3.3, §3.4) ---
    if [[ ${OPT[interactive]} -eq 1 && ${OPT[assume_yes]} -eq 1 ]]; then
        warn "--interactive and --yes are mutually exclusive; --yes wins, continuing non-interactively"
        OPT[interactive]=0
    fi
    if [[ ${OPT[sandbox]} -eq 1 && ${OPT[skip_ltrace]} -eq 1 ]]; then
        warn "--sandbox is a no-op with --skip-ltrace (the sandbox only ever wraps ltrace)"
    fi
    if [[ ${OPT[light_decompile]} -eq 1 && ${OPT[force_full_decompile]} -eq 1 ]]; then
        die "--light-decompile and --force-full-decompile are mutually exclusive"
    fi
    if [[ ${OPT[skip_ghidra]} -eq 1 && ${OPT[force_full_decompile]} -eq 1 ]]; then
        die "--skip-ghidra and --force-full-decompile are mutually exclusive"
    fi

    # A TUI needs a terminal; fall back silently rather than emitting escape codes
    # into a pipe (v6 §10).
    if [[ ${OPT[tui]} -eq 1 && ! -t 1 ]]; then
        OPT[tui]=0
    fi
}

# ======================================================================================
# Subcommand: scan
# ======================================================================================
cmd_scan() {
    if [[ ${OPT[verbose]} -eq 1 ]]; then
        _msg "revctf $REVCTF_VERSION"
        _msg "  target      : $TARGET"
        _msg "  config      : ${CONFIG_PATH}$([[ -r $CONFIG_PATH ]] || printf ' (absent)')"
        _msg "  output      : ${OPT[output_dir]:-<auto>}"
        _msg "  display     : $([[ ${OPT[tui]} -eq 1 ]] && printf tui || printf line)"
        _msg "  interactive : ${OPT[interactive]}   assume-yes: ${OPT[assume_yes]}"
    fi

    # --- M1: preflight -----------------------------------------------------------
    # shellcheck source=/dev/null
    source "$REVCTF_LIB/preflight.sh" || die "cannot load $REVCTF_LIB/preflight.sh"

    local out_hint="${OPT[output_dir]:-.}"
    preflight_run "$out_hint" "${OPT[skip_ghidra]}" || return 1

    if [[ ${OPT[verbose]} -eq 1 ]]; then
        preflight_summary >&2
    fi

    # --- M2: stage framework + Phase-1 light stages ------------------------------
    local m
    for m in stage stage_triage stage_file stage_strings stage_binwalk \
             stage_hexdump stage_checksec stage_objdump; do
        # shellcheck source=/dev/null
        source "$REVCTF_LIB/$m.sh" || die "cannot load $REVCTF_LIB/$m.sh"
    done

    # --- M5 lands here: tier resolution + --dry-run short-circuit ------------------
    # source "$REVCTF_LIB/tier.sh"; tier_resolve
    # [[ ${OPT[dry_run]} -eq 1 ]] && { tier_report; return 0; }

    if [[ -d $TARGET ]]; then
        printf 'revctf: batch mode is not yet implemented (M7); pass a single file for now.\n' >&2
        return 1
    fi

    scan_one_file "$TARGET"
}

# _abort_run <signal-name> — abort handler for INT, TERM and HUP.
#
# Exits 128+N for the signal received, the shell convention (130 for INT, 143 for TERM,
# 129 for HUP), so a supervisor can tell how the run was stopped.
#
# HUP is trapped because without it a dropped SSH session or a closed terminal killed the
# scan outright: no cleanup, work directory stranded, and on M3+ the traced challenge
# binary left running.
#
# KNOWN LIMIT — SIGINT cannot be caught when revctf is started as a background job from a
# NON-INTERACTIVE shell (`revctf scan x &` inside a script or CI runner). POSIX requires
# the shell to set SIGINT and SIGQUIT to ignored for such jobs, and bash will not install a
# trap for a signal that was ignored on entry; the process shows `SigIgn: …6` in
# /proc/<pid>/status. This is not fixable from inside bash. Use SIGTERM to stop a
# backgrounded revctf — it is trapped and behaves identically. Interactive Ctrl+C is
# unaffected, because the terminal delivers SIGINT to the foreground process group.
_abort_run() {
    local sig="${1:-INT}" num=2
    case "$sig" in INT) num=2 ;; TERM) num=15 ;; HUP) num=1 ;; esac
    trap - INT TERM HUP EXIT
    printf '\nrevctf: %s received — cleaning up\n' "SIG$sig" >&2
    # Kill the tool the current stage is waiting on, by its recorded PID. Signalling the
    # process group (`kill -- -$$`) was the obvious alternative and is wrong here: revctf
    # is only a process-group leader when a job-control shell made it one, so from a script
    # or a CI runner `-$$` names either nothing or, worse, somebody else's group.
    stage_kill_child
    stage_end_file
    exit $(( 128 + num ))
}

# resolve_output_dir <target> — ./revctf-reports/<basename>-<timestamp>/ unless --output
# was given (v6 §8).
resolve_output_dir() {
    local target="$1" base stamp
    if [[ -n ${OPT[output_dir]} ]]; then
        printf '%s' "${OPT[output_dir]}"
        return 0
    fi
    base="$(basename -- "$target")"
    stamp="$(date +%Y%m%d-%H%M%S)"
    printf './revctf-reports/%s-%s' "$base" "$stamp"
}

# scan_one_file <path> — Stage 0 then the Phase-1 light stages.
# Phases 2 and 3 (heavy extras, Ghidra) land in M3; report assembly lands in M4.
scan_one_file() {
    local target="$1" outdir
    outdir="$(resolve_output_dir "$target")"

    stage_begin_file "$target" "$outdir" || {
        die "could not prepare the working or output directory for $target"; }

    # Cleanup. Full SIGINT abort semantics come in M9 (v5 §4.5); this is the minimum that
    # leaves nothing behind.
    #
    # EXIT matters as much as INT/TERM: without it, any path that ends the shell without
    # reaching stage_end_file — a `die`, or a `set -u` abort inside a stage — strands the
    # work directory. That was observed leaking a directory per crash.
    #
    # The INT handler also kills the whole process group before exiting. `stage_capture`
    # runs its tool as a child, and a bare `exit` left it running: a Ctrl+C during a
    # `strings` over a large target left orphaned processes behind. This matters more from
    # M3 on, where ltrace and strace *execute the challenge binary* — an orphan there is a
    # piece of untrusted code still running after the user thinks they stopped it.
    trap 'stage_end_file' EXIT
    trap '_abort_run INT'  INT
    trap '_abort_run TERM' TERM
    trap '_abort_run HUP'  HUP

    stage_run triage   "classifying and unwrapping the target" stage_triage
    stage_run file     "identifying the file type"             stage_file
    stage_run strings  "extracting printable strings"          stage_strings
    stage_run binwalk  "scanning for embedded files"           stage_binwalk
    stage_run hexdump  "capturing a hex view"                  stage_hexdump
    stage_run checksec "reading mitigations and metadata"      stage_checksec
    stage_run objdump  "cross-checking with binutils"          stage_objdump

    # --- M3 stages and M4 report assembly land here -------------------------------
    m2_interim_summary

    # Exit status distinguishes "ran, all stages fine" from "ran, some stages failed".
    # Both are successful runs under v5 §4.1's isolate-and-continue rule, but a script or
    # CI job driving revctf had no way to tell them apart — every scan exited 0 even when
    # every stage had failed. Hard errors (bad arguments, missing tools, unwritable output)
    # keep exit 1; a completed scan with at least one failed stage now exits 2.
    local s failed=0
    for s in "${STAGE_ORDER[@]}"; do
        [[ ${STAGE_STATUS[$s]:-} == failed ]] && failed=$(( failed + 1 ))
    done

    trap - INT TERM HUP EXIT
    stage_end_file

    if [[ $failed -gt 0 ]]; then
        printf 'revctf: completed with %d stage(s) failed\n' "$failed" >&2
        return 2
    fi
    return 0
}

# Interim stdout summary, replaced by lib/report.sh in M4. It exists so M2 is verifiable
# on its own rather than only once the report layer arrives.
m2_interim_summary() {
    local s status note
    printf '\n'
    printf 'revctf %s — %s\n' "$REVCTF_VERSION" "$RUN_ORIGINAL"
    printf 'format: %s   captures: %s\n' "$RUN_FORMAT" "$RUN_OUTDIR"
    [[ $RUN_TARGET != "$RUN_ORIGINAL" ]] && printf 'analysed: %s (unwrapped)\n' "$RUN_TARGET"
    printf '\n%-10s  %-8s  %5s  %10s  %s\n' STAGE STATUS SECS BYTES NOTE
    for s in "${STAGE_ORDER[@]}"; do
        status="${STAGE_STATUS[$s]:-?}"
        note="${STAGE_NOTE[$s]:-}"
        printf '%-10s  %-8s  %5s  %10s  %s\n' \
            "$s" "$status" "${STAGE_SECS[$s]:-0}" \
            "$(st_file_size "${STAGE_OUT[$s]:-/dev/null}")" "$note"
    done
    printf '\n(M2: light static stages only — heavy stages M3, report M4)\n'
}

# ======================================================================================
# Entry
# ======================================================================================
main() {
    parse_args "$@"
    load_config
    validate_opts

    case "$SUBCOMMAND" in
        scan) cmd_scan ;;
        *)    die "unhandled subcommand '$SUBCOMMAND'" ;;
    esac
}

main "$@"
